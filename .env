# ==============================================
# DevSynt AutoGram Engine - Environment Variables
# ==============================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to GitHub!

# ========== GOOGLE DRIVE ==========
GOOGLE_DRIVE_CLIENT_ID=your_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret_here
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ========== SUPABASE ==========
SUPABASE_PROJECT_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=social-images

# ========== OPENAI ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# ========== INSTAGRAM/FACEBOOK ==========
FACEBOOK_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_user_id_here

# ========== EMAIL NOTIFICATIONS ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=automation@devsynt.com
EMAIL_TO=team@devsynt.com

# ========== WORKFLOW SETTINGS ==========
WORKFLOW_TIMEZONE=UTC
PROCESSING_BATCH_SIZE=1
MAX_RETRY_ATTEMPTS=3
LOG_LEVEL=info