              "value": "={{ $('Config').first().json.supabase_url }}/storage/v1/object/public/{{ $('Config').first().json.storage_bucket }}/{{ $('Loop Over Files').item.json.id }}-{{ $('Loop Over Files').item.json.name }}"
            }
