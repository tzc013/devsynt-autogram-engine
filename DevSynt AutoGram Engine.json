        },
        "options": {}
      },
      "id": "9f79cef7-3b45-472e-9486-680822f71866",
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1568,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/storage/v1/object/{{ $('Config').first().json.storage_bucket }}/{{ $json.object_path }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-upsert",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "06e45538-9c83-423f-9ee8-4428251ef9da",
      "name": "Upload to Supabase Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1792,
        192
      ]
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "gemini-2.5-flash"
        },
        "text": "Analyze this image and generate an Instagram caption and 20 hashtags.\nFormat exactly:\nCAPTION: [120-180 characters]\nHASHTAGS: [20 hashtags separated by spaces, each starting with #]",
        "imageUrls": "={{ $('Prepare Upload').item.json.public_url }}",
        "options": {
          "maxOutputTokens": 500
        }
      },
      "id": "d71b6c0a-55d5-4f9a-ab68-110be3bafbba",
      "name": "Generate Caption",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        2016,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const g = $json;\nlet raw = '';\nif (typeof g === 'string') { raw = g; }\nelse { raw = g.text || g.content || g.response || (g.content && g.content.parts && g.content.parts[0] && g.content.parts[0].text) || (g.candidates && g.candidates[0] && g.candidates[0].content && g.candidates[0].content.parts && g.candidates[0].content.parts[0] && g.candidates[0].content.parts[0].text) || ''; }\nif (typeof raw !== 'string') { raw = JSON.stringify(raw); }\nlet caption = '';\nlet hashtags = [];\nconst capMatch = raw.match(/CAPTION:\\s*([\\s\\S]*?)(?:HASHTAGS:|$)/i);\nif (capMatch) { caption = capMatch[1].trim(); }\nconst tagMatch = raw.match(/HASHTAGS:\\s*([\\s\\S]*)/i);\nif (tagMatch) { hashtags = (tagMatch[1].match(/#[A-Za-z0-9_]+/g) || []); }\nif (!caption) { caption = raw.trim().slice(0, 180); }\nconst prep = $('Prepare Upload').item.json;\nconst hashtags_str = hashtags.join(' ');\nconst pg = '{' + hashtags.map(function(h){ return '\"' + h.replace(/\"/g, '') + '\"'; }).join(',') + '}';\nreturn { json: { file_id: prep.file_id, filename: prep.filename, public_url: prep.public_url, caption: caption, hashtags: hashtags, hashtags_str: hashtags_str, hashtags_pg: pg, full_caption: (caption + '\\n\\n' + hashtags_str).trim() } };"
      },
      "id": "25e7b36a-8d08-4b92-95a8-e6a78758875d",
      "name": "Parse Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Config').first().json.ig_user_id }}/media",
